@page "/history"
@using System.Globalization
@using FilmExpiryChecker.Web.History
@using FilmExpiryChecker.Web.Refresh
@implements IDisposable
@inject RunHistory Runs
@inject LatestResults Latest
@inject TimeProvider Time

<PageTitle>Film Expiry Checker — History</PageTitle>

<h1>History</h1>

@if (_runs.Count == 0)
{
    <p>No refreshes have been saved yet. Each refresh that finishes is kept here: all of this week's, and the last of each earlier week.</p>
}
else
{
    <table class="history">
        <thead>
            <tr><th>When</th><th>Films</th><th>On your services</th><th>Leaving soon</th><th>For</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var run in _runs)
            {
                <tr @key="run.Id">
                    <td><a href="history/@run.Id">@When(run.RanAt)</a></td>
                    <td>@run.Films</td>
                    <td>@run.OnMyServices</td>
                    <td class="urgent">@run.LeavingSoon</td>
                    <td class="for">@run.Username · @run.Region</td>
                    <td class="row-actions">
                        @if (_confirming == run.Id)
                        {
                            <span class="confirm">Delete this run?</span>
                            <button type="button" class="button" @onclick="() => Delete(run.Id)">Delete</button>
                            <button type="button" class="button button--plain" @onclick="() => _confirming = null">Keep</button>
                        }
                        else
                        {
                            <a class="button button--plain" href="download/@(run.Id).csv" download>CSV</a>
                            <button type="button" class="button button--plain" @onclick="() => _confirming = run.Id">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_oldReports.Count > 0)
{
    <h2>Reports from the command line</h2>
    <p class="hint">Written before the app kept its own history. They open in a new tab.</p>
    <ul class="old-reports">
        @foreach (var report in _oldReports)
        {
            <li @key="report.FileName"><a href="reports/@report.FileName" target="_blank" rel="noopener">@report.WrittenAt.ToString("d MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</a></li>
        }
    </ul>
}

@code {
    private IReadOnlyList<RunSummary> _runs = [];
    private IReadOnlyList<OldReport> _oldReports = [];
    private string? _confirming;

    protected override void OnInitialized()
    {
        Load();
        Latest.Changed += OnNewResults;
    }

    private void Load()
    {
        _runs = Runs.List();
        _oldReports = Runs.OldReports();
    }

    private void Delete(string id)
    {
        Runs.Delete(id);
        _confirming = null;
        Load();
    }

    // A refresh finishing adds a run to the list.
    private void OnNewResults() => _ = InvokeAsync(() =>
    {
        Load();
        StateHasChanged();
    });

    private string When(DateTimeOffset ranAt) =>
        TimeZoneInfo.ConvertTime(ranAt, Time.LocalTimeZone).ToString("d MMM yyyy, HH:mm", CultureInfo.InvariantCulture);

    public void Dispose() => Latest.Changed -= OnNewResults;
}
