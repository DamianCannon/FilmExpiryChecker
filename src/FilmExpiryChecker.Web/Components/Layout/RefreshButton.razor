@using FilmExpiryChecker.Web.Refresh
@implements IDisposable
@inject IRefreshStatus Refresh

@* Greyed out until the page is live: the first HTML is shown before it can respond, and a click then is lost. *@
<button class="refresh-button" type="button" disabled="@(_running || !RendererInfo.IsInteractive)" @onclick="Start">
    @(_running ? "Refreshing…" : "Refresh")
</button>

@code {
    private bool _running;

    protected override void OnInitialized()
    {
        _running = Refresh.State is RefreshState.Running;
        Refresh.Changed += OnChanged;
    }

    private void Start() => Refresh.RequestRefresh();

    // Progress arrives many times a second; the button only re-renders when running starts or stops.
    private void OnChanged(RefreshState state)
    {
        if ((state is RefreshState.Running) == _running) return;
        _ = InvokeAsync(() =>
        {
            _running = Refresh.State is RefreshState.Running;
            StateHasChanged();
        });
    }

    public void Dispose() => Refresh.Changed -= OnChanged;
}
